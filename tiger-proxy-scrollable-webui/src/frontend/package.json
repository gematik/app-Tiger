{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:detached": "vue-tsc -b && vite build --mode=detached",
    "build:all": "npm run build:detached && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && npm run format",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "format": "prettier --write src/",
    "postinstall": "patch-package",
    "playwright:install": "npx playwright install chromium"
  },
  "overrides": {
    "ansi-regex": "5.0.1",
    "ansi-styles": "5.2.0",
    "backslash": "0.2.0",
    "chalk": "5.6.2",
    "chalk-template": "1.1.2",
    "color-convert": "3.1.0",
    "color-name": "2.0.0",
    "color-string": "2.1.0",
    "debug": "4.4.1",
    "error-ex": "1.3.2",
    "has-ansi": "6.0.2",
    "is-arrayish": "0.3.2",
    "simple-swizzle": "0.2.2",
    "slice-ansi": "7.1.2",
    "strip-ansi": "6.0.1",
    "supports-color": "10.2.2",
    "supports-hyperlinks": "4.1.1",
    "wrap-ansi": "9.0.2",
    "nth-check": "2.1.1",
    "vue-template-compiler": "2.7.16"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@popperjs/core": "2.11.8",
    "@vue/test-utils": "2.4.11",
    "@vueuse/core": "14.4.0",
    "bootstrap": "5.3.8",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "patch-package": "8.0.1",
    "simple-syntax-highlighter": "3.2.0",
    "vitest": "4.1.11",
    "vue": "3.5.43",
    "vue-router": "5.2.0",
    "vue-virtual-scroller": "3.0.5"
  },
  "devDependencies": {
    "@types/bootstrap": "5.2.11",
    "@types/node": "24.10.9",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/ui": "4.1.11",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.10.0",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "rollup-plugin-visualizer": "7.1.1",
    "sass": "1.103.1",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vite-svg-loader": "5.1.2",
    "vue-tsc": "3.3.11"
  }
}
